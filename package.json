{
  "name": "@metreeca/flow",
  "version": "0.11.1",
  "description": "Composable primitives for asynchronous data flows.",
  "keywords": [
    "typescript",
    "utilities"
  ],
  "homepage": "https://metreeca.github.io/flow/",
  "bugs": {
    "url": "https://github.com/metreeca/flow/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/flow.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./feeds": {
      "@metreeca/source": "./src/feeds/index.ts",
      "default": "./dist/feeds/index.js"
    },
    "./tasks": {
      "@metreeca/source": "./src/tasks/index.ts",
      "default": "./dist/tasks/index.js"
    },
    "./sinks": {
      "@metreeca/source": "./src/sinks/index.ts",
      "default": "./dist/sinks/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ln",
    "build": "rm dist docs && npx tsc && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx wds --root-dir docs --watch --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.12.1"
  },
  "devDependencies": {
    "@metreeca/rack": "^0.4.0",
    "@web/dev-server": "^1.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents": true
  }
}
